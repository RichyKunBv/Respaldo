<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Carreras.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:Carreras.Pages" 
    Shell.FlyoutBehavior="Disabled">
    
    <!-- Reemplaza "TuApp" con el namespace real de tu proyecto -->

    <TabBar>
        <Tab Title="Psicología">
            <ShellContent ContentTemplate="{DataTemplate pages:PsicPage}" />
        </Tab>
        <Tab Title="Derecho">
            <ShellContent ContentTemplate="{DataTemplate pages:DerechoPage}" />
        </Tab>
    </TabBar>

</Shell>