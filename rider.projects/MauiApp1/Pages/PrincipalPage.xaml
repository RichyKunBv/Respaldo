<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Pages.PrincipalPage">
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="estiloLabel" TargetType="Label">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="TextColor" Value="#333333" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="Margin" Value="0,10,0,0" />
            </Style>
            
            <Style x:Key="estiloBoton" TargetType="Button">
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="HeightRequest" Value="45" />
            </Style>

            <Style x:Key="botonRojo" TargetType="Button" BasedOn="{StaticResource estiloBoton}">
                <Setter Property="BackgroundColor" Value="Red"></Setter>
            </Style>

        </ResourceDictionary>
    </ContentPage.Resources>
    
    <ContentPage.Content>
        <VerticalStackLayout Padding="30" Spacing="15" VerticalOptions="Start">
            <Label Text="si jalo" Style="{StaticResource estiloLabel}"/>
            <Button x:Name="btnRegresar" Text="Salir" 
                    Clicked="BtnRegresar_OnClicked" 
                    Style="{StaticResource botonRojo}"
                    HorizontalOptions="Center"></Button>
        </VerticalStackLayout>
    </ContentPage.Content>
</ContentPage>