<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Menu.PlatillosPage"
             Title="Nuestros Platillos">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            
            <Label Text="Platos Principales" 
                   FontSize="24" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center" />

            <!-- Ejemplo de un platillo -->
            <Frame Padding="15" CornerRadius="10" HasShadow="True">
                <VerticalStackLayout>
                    <Label Text="Enchiladas Suizas" FontSize="18" FontAttributes="Bold"/>
                    <Label Text="Deliciosas enchiladas bañadas en salsa verde con queso gratinado." TextColor="Gray" />
                    <Label Text="$120.00" FontSize="16" TextColor="Green" FontAttributes="Bold" Margin="0,5,0,0"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Ejemplo de otro platillo -->
            <Frame Padding="15" CornerRadius="10" HasShadow="True">
                <VerticalStackLayout>
                    <Label Text="Tacos al Pastor" FontSize="18" FontAttributes="Bold"/>
                    <Label Text="Orden de 5 tacos con piña, cilantro y cebolla." TextColor="Gray" />
                    <Label Text="$90.00" FontSize="16" TextColor="Green" FontAttributes="Bold" Margin="0,5,0,0"/>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>